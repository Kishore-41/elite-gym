# ==============================================================================
# Elite Athletic Club Backend Environment Variables
# ==============================================================================

# Server Port
PORT=8080

# Spring Active Profile (dev or prod)
SPRING_PROFILES_ACTIVE=prod

# Production Database Datasource
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/elite_gym?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Dynamic CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://elitegym.vercel.app

# JWT Secret & Expiration
JWT_SECRET=dGhpcy1pcy1hLXZlcnktc2VjdXJlLWFuZC1sb25nLXNlY3JldC1rZXktZm9yLWVsaXRlLWd5bS1qd3QtYXV0aGVudGljYXRpb24tMjAyNg==
